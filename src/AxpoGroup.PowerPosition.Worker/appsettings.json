{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ScheduledExtractOptions": {
    "ExtractIntervalMinutes": 5, // interval in minutes between scheduled extracts
    "MaxRetries": 3, // maximum retry attempts if extract fails
    "RetryDelaySeconds": 10 // delay in seconds between retries
  },
  "CsvExportOptions": {
    "OutputDirectory": "C:\\Reports\\PowerPosition", // directory where CSV files are saved
    "FileNamePattern": "PowerPosition_{timestamp}.csv", // pattern with timestamp placeholder
    "TimestampFormat": "yyyyMMdd_HHmm" // timestamp format appended to file name
  }
}
